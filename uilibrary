function WindowTable:SetTheme(themeName)
    if not Themes[themeName] then return end
    CurrentTheme = Themes[themeName]
    if WindowTable.Library then
        for _, inst in ipairs(WindowTable.Library:GetDescendants()) do
            if inst.Name == "MainFrame" or inst.Name == "MainFrameGlow" then inst.BackgroundColor3 = T("Main")
            elseif inst.Name == "MainFrameGlow1" or inst.Name == "MainFrameGlow2" then inst.ImageColor3 = T("Main")
            elseif inst.Name == "LeftFrame" or inst.Name == "LeftFrameLine" then inst.BackgroundColor3 = T("Sidebar")
            elseif inst.Name == "AllPages" then inst.BackgroundColor3 = T("Content")
            elseif inst.Name == "Button" or inst.Name == "ToggleBtn" or inst.Name == "Slider" or inst.Name == "Dropdown" or inst.Name == "DropItemHolder" or inst.Name == "Option" or inst.Name == "Colorpicker" or inst.Name == "ColorpickerFrame" or inst.Name == "Confirm" or inst.Name == "RainbowToggle" or inst.Name == "LabelText" or inst.Name == "TextboxFrame" or inst.Name == "ToggleTooltip" then inst.BackgroundColor3 = T("Element")
            elseif inst.Name == "SlideFrame" or inst.Name == "Value" or inst.Name == "InputBox" then 
                inst.BackgroundColor3 = T("AccentOff")
            elseif inst.Name == "CurrentValueFrame" or inst.Name == "SlideCircle" then 
                inst.BackgroundColor3 = T("Accent")
                if inst.Name == "SlideCircle" then inst.ImageColor3 = T("Accent") end
            
            elseif inst.Name == "ToggleBox" then
                if inst:GetAttribute("IsActive") then inst.BackgroundColor3 = T("Accent")
                else inst.BackgroundColor3 = T("AccentOff") end
            elseif inst.Name == "RainbowStatus" then
                if inst:GetAttribute("IsActive") then inst.BackgroundColor3 = T("Accent")
                else inst.BackgroundColor3 = T("AccentOff") end
                
            elseif inst.Name == "Line" then inst.BackgroundColor3 = T("SecondaryText"); inst.BackgroundTransparency = 0.8
            elseif inst.Name == "TabBtnGradient" then inst.Color = ColorSequence.new{ColorSequenceKeypoint.new(0.00, T("Gradient1")), ColorSequenceKeypoint.new(1.00, T("Gradient2"))}
            end
            
            if inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox") then
                if inst.Name == "Title" or inst.Name == "MainTabsBtnTitle" or inst.Name == "TabBtnTitle" or inst.Name == "ButtonTitle" or inst.Name == "ToggleTitle" or inst.Name == "SliderTitle" or inst.Name == "DropdownTitle" or inst.Name == "TabLine" or inst.Name == "TextboxTitle" or inst.Name == "TooltipText" then inst.TextColor3 = T("Text")
                elseif inst.Name == "Option" or inst.Name == "Confirm" or inst.Name == "RainbowTitle" or inst.Name == "InputBox" then inst.TextColor3 = T("SecondaryText")
                end
            end
        end
    end
end

